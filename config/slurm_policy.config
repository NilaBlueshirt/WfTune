// Common Slurm placement policy for the native and job-array treatments.
// The login-side launcher exports the same partition/account/QOS/node feature
// used by the enclosing HQ, Flux, and local allocations.  This controls node
// class without pretending that native per-task allocations and bulk
// allocations have identical scheduling architectures.

def wftunePartition = System.getenv('WMSbench_PARTITION')
def wftuneAccount = System.getenv('WMSbench_ACCOUNT') ?: ''
def wftuneQos = System.getenv('WMSbench_QOS') ?: ''
def wftuneConstraint = System.getenv('WMSbench_NODE_CONSTRAINT') ?: ''
def wftuneExtra = System.getenv('WMSbench_SLURM_TASK_EXTRA') ?: ''

def wftuneClusterOptions = []
if (wftuneAccount)    wftuneClusterOptions << "--account=${wftuneAccount}"
if (wftuneQos)        wftuneClusterOptions << "--qos=${wftuneQos}"
if (wftuneConstraint && wftuneConstraint != 'none')
    wftuneClusterOptions << "--constraint=${wftuneConstraint}"
if (wftuneExtra)      wftuneClusterOptions << wftuneExtra

process {
    queue = wftunePartition
    if (wftuneClusterOptions) {
        clusterOptions = wftuneClusterOptions.join(' ')
    }
}
