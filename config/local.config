// Local execution within one exclusive Slurm node using site-specific caps.

def wftuneProcessSelector = System.getenv('WMSbench_NF_PROCESS_SELECTOR')
def wftuneLocalCpus = System.getenv('WMSbench_LOCAL_CPUS') as int
def wftuneNodeMemory = System.getenv('WMSbench_NODE_MEMORY')
def wftuneLocalQueueSize = System.getenv('WMSbench_NF_LOCAL_QUEUE_SIZE') as int
def wftuneLocalTimeSeconds = System.getenv('WMSbench_NF_LOCAL_TIME_SECONDS') as int
def wftuneBeforeScript = System.getenv('WMSbench_NF_BEFORE_SCRIPT')

process {
    executor = 'local'

    withName: '.*' {
        // Zero survives config merging but TaskConfig resolves it as no duration.
        time = wftuneLocalTimeSeconds
    }

    withName: wftuneProcessSelector {
        array        = 0
        beforeScript = wftuneBeforeScript
    }
}

executor {
    name      = 'local'
    cpus      = wftuneLocalCpus
    memory    = wftuneNodeMemory
    queueSize = wftuneLocalQueueSize
}
