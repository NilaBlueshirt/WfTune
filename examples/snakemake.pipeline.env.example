#!/usr/bin/env bash
# Central benchmark-user configuration for a standard Snakemake workflow.
#
# Expected repository shape (paths may differ when explicitly configured):
#   workflow/Snakefile
#   config/config.yaml
#   profiles/<site>/profile.yaml
#
# Copy and fill this file outside the source tree.  The controller freezes its
# hash in each run.  Do not put generated data or results in WfTune.

export WMSbench_PIPELINE="FILL_IN_PIPELINE_NAME"
export WMSbench_PIPELINE_REVISION="FILL_IN_COMMIT_OR_RELEASE"
export WMSbench_SNAKEFILE="/absolute/path/to/workflow/workflow/Snakefile"
WMSbench_SNAKEMAKE_COMMAND=(snakemake)

# Snakemake accepts a YAML file directly as a profile.  Keeping each profile in
# one file makes the frozen hash unambiguous.  The global profile should contain
# site/executor resource policy; the optional workflow profile should contain
# rule-level resource overrides.  Use an empty string when there is no separate
# workflow profile.
export WMSbench_SNAKEMAKE_PROFILE="/absolute/path/to/profiles/site/profile.yaml"
export WMSbench_SNAKEMAKE_WORKFLOW_PROFILE=""
export WMSbench_SNAKEMAKE_CONFIGFILE="/absolute/path/to/config/config.yaml"
export WMSbench_SNAKEMAKE_JOBS=FILL_IN_MAX_ACTIVE_JOBS

# Both supported Snakemake treatments use the official Slurm executor plugin. The array
# adapter additionally supplies --slurm-array-jobs=all and the configured array
# limit.  Change these values here if the selected workflow needs another
# installed executor implementation.
export WMSbench_SNAKEMAKE_EXECUTOR_NATIVE="slurm"
export WMSbench_SNAKEMAKE_EXECUTOR_JOBARRAY="slurm"
export WMSbench_SNAKEMAKE_ARRAY_RULES="all"

# Every trailing option and target is frozen through this file's SHA-256.  Put
# pipeline-specific output-directory parameters here, because the harness must
# not guess the parameter name used by an arbitrary Snakefile.  At source time
# WMSbench_PIPELINE_RUN_DIR names the fresh trial directory.
WMSbench_SNAKEMAKE_COMMON_ARGS=(
    --rerun-incomplete
    --printshellcmds
    --show-failed-logs
    # Example only; replace `outdir` with the selected workflow's real key:
    # --config "outdir=$WMSbench_PIPELINE_RUN_DIR/results"
)
WMSbench_SNAKEMAKE_NATIVE_ARGS=()
WMSbench_SNAKEMAKE_JOBARRAY_ARGS=()
WMSbench_SNAKEMAKE_TARGETS=(FILL_IN_TARGET_RULE_OR_FILE)

# Slurm placement is passed as command-line default resources so it cannot
# silently diverge from the controller account/partition contract.  Add the
# scientific defaults required by the selected workflow.  Rule-specific CPU
# and memory values belong in SET_RESOURCES/SET_THREADS or the optional
# workflow profile; do not override account, partition, or constraint per rule.
WMSbench_SNAKEMAKE_DEFAULT_RESOURCES=(
    "slurm_account=$WMSbench_ACCOUNT"
    "slurm_partition=$WMSbench_PARTITION"
    "mem_mb=FILL_IN_DEFAULT_MEMORY_MIB"
    "runtime=FILL_IN_DEFAULT_RUNTIME_MINUTES"
)
if [[ $WMSbench_NODE_CONSTRAINT != none ]]; then
    WMSbench_SNAKEMAKE_DEFAULT_RESOURCES+=("constraint=$WMSbench_NODE_CONSTRAINT")
fi
WMSbench_SNAKEMAKE_SET_RESOURCES=()
WMSbench_SNAKEMAKE_SET_THREADS=()

# Frozen scientific and software manifests.  For a workflow with multiple
# containers, WMSbench_CONTAINER_DIGEST is the SHA-256 of the canonical
# container-manifest file, written with the required `sha256:` prefix.
export WMSbench_INPUT_MANIFEST="/absolute/path/to/frozen-input-manifest.json"
export WMSbench_PIPELINE_SOURCE_MANIFEST="/absolute/path/to/frozen-source-manifest.json"
export WMSbench_CONTAINER_DIGEST="sha256:FILL_IN_64_HEX_MANIFEST_DIGEST"

# Site geometry and common analysis contract.  These values are configuration,
# not code. HQ and Flux fields are retained because the shared WfTune schema
# can also analyze the full five-mode Nextflow campaign; they do not enable
# unsupported Snakemake treatments.
export WMSbench_PHYSICAL_NODE_CPUS=FILL_IN
export WMSbench_PHYSICAL_NODE_MEMORY="FILL_IN_GB"
export WMSbench_ALLOCATION_CPUS=FILL_IN
export WMSbench_LOCAL_CPUS=FILL_IN
export WMSbench_NODE_MEMORY="FILL_IN_GB"
export WMSbench_BULK_NODES=FILL_IN
export WMSbench_ARRAY_SIZE=FILL_IN
export WMSbench_SLURM_QUEUE_SIZE=FILL_IN
export WMSbench_HQ_WORKERS=1
export WMSbench_HQ_WORKER_CPUS=1
export WMSbench_FLUX_NODES=1

# Pin the Snakemake environment, executor plugin, container runtime, and any
# workflow-specific software modules.  Leave the array empty when the command
# is supplied by an already activated immutable environment.
export WMSbench_MODULE_INIT="/usr/share/lmod/lmod/init/bash"
WMSbench_MODULES=(
    snakemake/FILL_IN
    apptainer/FILL_IN
)
