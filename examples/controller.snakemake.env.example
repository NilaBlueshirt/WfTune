#!/usr/bin/env bash
# Controller-root settings for the WfTune Snakemake campaign. Copy this file outside the repository,
# fill every placeholder, then source it as root on the Slurm controller.

# Harness and identity. This trusted file is sourced by root: install the
# filled copy as root:root mode 0600. Venue is a run_rep.sh argument.
# Install a root-owned, group/world-nonwritable campaign snapshot. This path
# must be the same readable path on the controller and main compute allocation
# because the pseudo batch scripts source their shared body.
export WMSbench_HARNESS_ROOT="/absolute/shared/path/to/WfTune"
export WMSbench_WMS="snakemake"
export WMSbench_SUPPORTED_BACKENDS="native,jobarray"
export WMSbench_CAMPAIGN_ID="wftune"
export WMSbench_CLUSTER="FILL_IN_SLURM_CLUSTER_NAME"
export WMSbench_BENCH_USER="FILL_IN_BENCHMARK_USER"
export WMSbench_ACCOUNT="FILL_IN_DEDICATED_ACCOUNT"
export WMSbench_PARTITION="FILL_IN"
export WMSbench_QOS=""
export WMSbench_NODE_CONSTRAINT="FILL_IN_ONE_NODE_TYPE"
# Optional local-only placement. Empty values inherit the common placement.
export WMSbench_LOCAL_PARTITION=""
export WMSbench_LOCAL_QOS=""
export WMSbench_LOCAL_NODE_CONSTRAINT=""
export WMSbench_LOCAL_NODELIST=""

# These roots must be different. Monitoring artifacts belong under the first
# root; Snakemake results, workspace, trace, and logs belong under the second root.
# The batch node writes only handoff/ below this otherwise root-owned tree, so
# this root must be visible from both slurmctld and the submitted main job.
export WMSbench_MONITOR_ROOT="/absolute/shared/path/wftune-monitor/snakemake"
export WMSbench_PIPELINE_ROOT="/absolute/shared/path/wftune-pipeline-runs/snakemake"
export WMSbench_LOCK_ROOT="/absolute/root-owned/path/wftune-locks"

export WMSbench_PRE_BASELINE_SECONDS=0
# Fixed no-RPC release-settle tail before the final controller boundary.
export WMSbench_POST_BASELINE_SECONDS=30
export WMSbench_UTC_GUARD_SECONDS=900
export WMSbench_SDIAG_INTERVAL_SECONDS=300
export WMSbench_MARKER_POLL_SECONDS=5
export WMSbench_CANCEL_GRACE_SECONDS=120
export WMSbench_AUTO_WAIT_FOR_UTC_RESET=1
# Time of day, in UTC, at which this venue's slurmctld rolls the sdiag
# cumulative-statistics generation. A trial is refused when it is too close to
# the next roll to preserve the preparation and closure guards, and the
# block driver waits for the fresh generation before retrying.
#
# Confirm it per cluster instead of assuming, because `sdiag` prints its
# `Data since` line in the controller node's LOCAL zone, not in UTC:
#
#   sdiag | head -3
#   Data since      Tue Aug 04 17:00:00 2026 (example epoch)
#
# Convert the displayed local time to UTC using the controller's configured
# timezone, then record the observed roll time below.
export WMSbench_SDIAG_GENERATION_ROLL_UTC="00:00"

# Controller commands. Keep sdiag cadence at 300 seconds or longer. These are
# command names/paths, not pipeline commands.
export WMSbench_SDIAG_COMMAND="/usr/bin/sdiag"
export WMSbench_SSHARE_COMMAND="/usr/bin/sshare"
export WMSbench_SQUEUE_COMMAND="/usr/bin/squeue"
export WMSbench_SACCTMGR_COMMAND="/usr/bin/sacctmgr"
export WMSbench_SBATCH_COMMAND="/usr/bin/sbatch"
export WMSbench_SCANCEL_COMMAND="/usr/bin/scancel"
export WMSbench_TIMEOUT_COMMAND="/usr/bin/timeout"
export WMSbench_COMMAND_TIMEOUT_SECONDS=120
export WMSbench_TIMEOUT_KILL_AFTER_SECONDS=10
export WMSbench_FAIRSHARE_VERIFY_SECONDS=120
export WMSbench_FAIRSHARE_HIERARCHY=none

# The bundled reset helper resets this benchmark user's association in the
# account, verifies zero, and refuses if that user still has a job.

# Source the filled pipeline environment before launching a replicate.
export WMSbench_PIPELINE_ENV_FILE="/absolute/path/to/snakemake.pipeline.env"

# Endpoint/trace admission contract. Keep identical at both venues.
export WMSbench_ENDPOINT_PROCESS="WORKFLOW"
export WMSbench_ENDPOINT_LOGICAL_KEY_COLUMN="name"
export WMSbench_ALLOWED_PROCESS_REGEX='WORKFLOW'
export WMSbench_TRACE_TIMEZONE="FILL_IN_IANA_TIMEZONE"

# Manual runner only. The inherited manual protocol is Nextflow-only; this
# value remains empty for Snakemake.
export WMSbench_POST_ENDPOINT_PROCESS_REGEX=''

# Two user-owned batch entry points. The controller submits each one as the
# benchmark user and writes Slurm monitoring elsewhere under MONITOR_ROOT.
export WMSbench_SBATCH_NATIVE="/absolute/path/to/examples/snakemake-native.sbatch"
export WMSbench_SBATCH_JOBARRAY="/absolute/path/to/examples/snakemake-jobarray.sbatch"

# Required semantic admission check, run after Snakemake and outside measured
# endpoint walltime. Name one executable validator wrapper (no inline shell
# command or arguments). Install it and its direct parent as root-owned,
# group/world-nonwritable, and symlink-free. Root freezes/hashes it before t0; the controller
# supplies WMSbench_PIPELINE_RUN_DIR and WMSbench_MONITOR_RUN_DIR when it runs.
export WMSbench_VALIDATION_COMMAND="/absolute/path/to/validate_selected_workflow_outputs.sh"
export WMSbench_PYTHON="/absolute/path/to/python"

# Slurm options are passed on the sbatch command line because #SBATCH does not
# expand shell variables. Common options describe the launcher allocation;
# backend arrays may add literal resource-envelope options.
WMSbench_SBATCH_COMMON_ARGS=(--nodes=1 --ntasks=1 --cpus-per-task=1 --time=08:30:00)
# Native and Job Array place only the Snakemake driver in this allocation; the
# official Slurm executor plugin dispatches scientific tasks separately.
WMSbench_SBATCH_NATIVE_ARGS=()
WMSbench_SBATCH_JOBARRAY_ARGS=()
